<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleGetInfoString</key>
	<string>${MACOSX_BUNDLE_INFO_STRING}</string>
	<key>CFBundleIconFile</key>
	<string>${MACOSX_BUNDLE_ICON_FILE}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLongVersionString</key>
	<string>${MACOSX_BUNDLE_LONG_VERSION_STRING}</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>CSResourcesFileMapped</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>${MACOSX_BUNDLE_COPYRIGHT}</string>

	<!-- Lets Finder route "open"/double-click/drag-onto-dock-icon for .taf files to us, delivered
	     as a QFileOpenEvent (see StarlaneApplication::event() in starlane.cpp). LSHandlerRank is
	     Default rather than Owner: Starlane only plays ADRIFT 5 games (see the V4ident/V39ident
	     checks in taffile.cpp's ExtractTaf) and shouldn't claim sole authority over an extension
	     that ADRIFT 4 games also use -- and that some other multi-interpreter (e.g. a
	     starlane-glk-based Gargoyle build) may legitimately want to be considered for too.

	     public.adrift, not a Starlane-specific identifier: it's the identifier Gargoyle and
	     Spatterlight (both already installed .taf handlers on macOS) already use for this
	     extension. Several apps minting their own distinct UTI for the same extension is exactly
	     the situation Launch Services handles ambiguously (which one "wins" for default-open and
	     Open With becomes registration-order dependent); sharing the existing identifier avoids
	     that. Gargoyle's Info.plist declares it via UTExportedTypeDeclarations (i.e. Gargoyle
	     considers itself the type's origin); we follow Spatterlight's lead and import it instead
	     of re-exporting it, since there should only be one canonical exporter. We still declare it
	     ourselves (rather than only referencing the bare string below) so type/extension
	     resolution stays correct even on a machine where neither Gargoyle nor Spatterlight -- our
	     actual likely-only source of a public.adrift declaration -- happens to be installed. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>ADRIFT 5 Game File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.adrift</string>
			</array>
		</dict>
		<!-- public.blorb is Gargoyle's identifier too (it's the exporter; see the
		     UTImportedTypeDeclarations entry below), shared with Z-code/Glulx Blorb archives,
		     which is exactly why LSHandlerRank stays Default here as well: a plain .blorb/.blb
		     isn't necessarily one of ours. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>ADRIFT 5 Blorb File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.blorb</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>public.adrift</string>
			<key>UTTypeDescription</key>
			<string>ADRIFT Story File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.content</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>taf</string>
				</array>
			</dict>
		</dict>
		<!-- Same reasoning as public.adrift above: confirmed via the installed Gargoyle/
		     Spatterlight bundles again, Gargoyle exports public.blorb (UTExportedTypeDeclarations)
		     rather than importing it, so we do the same import-not-export as public.adrift here.
		     UTTypeConformsTo matches Spatterlight's own import ([public.content, public.data])
		     rather than Gargoyle's export (which instead lists its own private
		     com.googlecode.garglk alongside public.data); conforming to a Gargoyle-specific type
		     wouldn't make sense from an app that isn't Gargoyle. blb/blorb are the extensions both
		     of them actually register; adriftblorb is added on top since Blorb-Spec.md's "ADRIFT 5
		     Compatibility Issues" section blesses it as an alternate suffix specifically for
		     ADRIFT's own Blorb files, which is the only kind this app ever produces or reads. -->
		<dict>
			<key>UTTypeIdentifier</key>
			<string>public.blorb</string>
			<key>UTTypeDescription</key>
			<string>ADRIFT Blorb Archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.content</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>blb</string>
					<string>blorb</string>
					<string>adriftblorb</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
